# ═══════════════════════════════════════════════════════════════════════════
# Django Examination System - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual values (never commit .env to version control)
# 3. Load these variables before running Django
#
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# DJANGO CORE SETTINGS
# ───────────────────────────────────────────────────────────────────────────

# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-super-secret-key-here-change-me

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (required in production)
# Example: DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ───────────────────────────────────────────────────────────────────────────
# DATABASE SETTINGS (for PostgreSQL in production)
# ───────────────────────────────────────────────────────────────────────────

DB_NAME=examination_system
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# ───────────────────────────────────────────────────────────────────────────
# EMAIL SETTINGS
# ───────────────────────────────────────────────────────────────────────────

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# For Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the generated password (NOT your regular Gmail password)

# ───────────────────────────────────────────────────────────────────────────
# REDIS SETTINGS (Optional - for caching in production)
# ───────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://127.0.0.1:6379/1

# ───────────────────────────────────────────────────────────────────────────
# CUSTOM ADMIN URL (Optional - for extra security)
# ───────────────────────────────────────────────────────────────────────────

ADMIN_URL=admin/

# ───────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTES
# ───────────────────────────────────────────────────────────────────────────

# For development:
#   python manage.py runserver
#
# For production:
#   export DJANGO_SETTINGS_MODULE=examination_system.settings_production
#   python manage.py collectstatic --noinput
#   python manage.py migrate
#   gunicorn examination_system.wsgi:application --bind 0.0.0.0:8000
#
# Or use the deployment script (if available)

